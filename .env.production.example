# Production environment for the GOTC API.
#
# Copy these into Render → your service → Environment. Do not commit real values.
# `render.yaml` already sets everything except the two secrets.

NODE_ENV=production

# Leave PORT unset — Render injects it and src/config/env.ts reads it.

# The Atlas connection string, pointing at GOTC's own database.
# Keep the /tcms_dev_v1 database name; anything else needs seeding first.
MONGODB_URI=mongodb://<user>:<password>@<cluster-hosts>/tcms_dev_v1?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority

# 32+ characters. Generate a fresh one for production — do not reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

COOKIE_NAME=gotc_session

# Browser origins allowed to call this API cross-origin. Comma separated; an entry may use
# a `*.` subdomain wildcard, which is how Vercel preview deployments are covered.
# Unused when the front end proxies /api through its own domain (the default setup).
CLIENT_ORIGIN=https://gotc-clie.vercel.app,https://*.vercel.app

LOG_LEVEL=info

# Stops mongodb-memory-server downloading a ~100 MB mongod binary during the build.
# It is a devDependency used only by the test suite.
MONGOMS_DISABLE_POSTINSTALL=1
